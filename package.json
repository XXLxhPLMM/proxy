{
  "name": "@b-hole/proxy",
  "version": "5.1.3",
  "description": "Proxy server (v5 rewrite) - multi-mode proxy with decoupled core",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "proxy": "dist/app.js",
    "b-hole-proxy": "dist/app.js"
  },
  "type": "commonjs",
  "files": [
    "lib",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "build:watch": "node build.mjs --watch",
    "build:lib": "node scripts/clean-lib.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:all": "pnpm build && pnpm build:lib",
    "start": "node dist/app.js",
    "start:dev": "cross-env NODE_ENV=development node dist/app.js",
    "start:prod": "cross-env NODE_ENV=production node dist/app.js",
    "dev": "pnpm build:dev && pnpm start:dev",
    "dev:watch": "node scripts/dev-server.mjs",
    "dev:hot": "cross-env FORCE_COLOR=1 concurrently -n build,server --prefix-colors green,cyan \"pnpm build:watch\" \"node scripts/dev-server.mjs\"",
    "dev:http": "pnpm build:dev && cross-env PROXY_PROTOCOL=http pnpm start:dev",
    "dev:socks": "pnpm build:dev && cross-env PROXY_PROTOCOL=socks5 pnpm start:dev",
    "dev:tls": "pnpm build:dev && cross-env PROXY_PROTOCOL=sockss5 pnpm start:dev",
    "start:http": "cross-env PROXY_PROTOCOL=http pnpm start",
    "start:socks": "cross-env PROXY_PROTOCOL=socks5 pnpm start",
    "start:tls": "cross-env PROXY_PROTOCOL=sockss5 pnpm start",
    "start:client": "cross-env PROXY_MODE=client node dist/app.js",
    "start:client:dev": "cross-env NODE_ENV=development PROXY_MODE=client node dist/app.js",
    "build:pkg": "pnpm build && node scripts/patch-pkg-fetch.mjs && node scripts/build-pkg.mjs && node scripts/package-dist.mjs",
    "lint": "eslint ./src ./tests --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "node tests/http-test-server.mjs",
    "test:pressure": "node tests/perf/socks4-pressure.mjs",
    "test:pressure:direct": "node tests/perf/http-pressure.mjs"
  },
  "keywords": [],
  "author": "",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@yao-pkg/pkg": "^6.22.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "yazl": "^3.3.1"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      ".env.*",
      "package.json",
      "README.md",
      "cfg/*.example"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64",
      "node22-darwin-x64"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
