{
  "name": "@b-hole/proxy",
  "version": "5.0.0",
  "description": "Proxy server (v5 rewrite) - multi-mode proxy with decoupled core",
  "main": "dist/app.js",
  "bin": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node --env-file=.env --env-file-if-exists=.env.local dist/app.js",
    "start:dev": "node --env-file=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.dev --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --env-file-if-exists=.env.dev.local dist/app.js",
    "start:prod": "node --env-file=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local dist/app.js",
    "dev": "pnpm build && pnpm start:dev",
    "dev:client": "pnpm build && cross-env APP_MODE=client pnpm start:dev",
    "dev:manager": "pnpm build && cross-env APP_MODE=manager pnpm start:dev",
    "dev:IM": "pnpm build && cross-env APP_MODE=intermediary pnpm start:dev",
    "start:client": "cross-env APP_MODE=client pnpm start",
    "start:manager": "cross-env APP_MODE=manager pnpm start",
    "start:client:dev": "cross-env APP_MODE=client pnpm start:dev",
    "start:client:prod": "cross-env APP_MODE=client pnpm start:prod",
    "build:pkg": "pnpm build && pkg .",
    "postinstall": "node scripts/patch-pkg-fetch.mjs",
    "lint": "eslint ./src --ext .ts"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "pkg": "^5.8.1",
    "typescript": "^5.8.3"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      ".env",
      ".env.*",
      "package.json",
      "README.md"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64",
      "node22-darwin-x64"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
