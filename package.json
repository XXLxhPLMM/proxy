{
  "name": "@b-hole/proxy",
  "version": "5.0.0",
  "description": "Proxy server (v5 rewrite) - multi-mode proxy with decoupled core",
  "main": "dist/app.js",
  "bin": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/app.js",
    "start:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.development dist/app.js",
    "start:prod": "node --env-file-if-exists=.env --env-file-if-exists=.env.production dist/app.js",
    "dev": "pnpm build && pnpm start:dev",
    "dev:watch": "node --watch dist/app.js --env-file-if-exists=.env --env-file-if-exists=.env.development",
    "dev:hot": "concurrently \"pnpm build:watch\" \"node --watch dist/app.js --env-file-if-exists=.env --env-file-if-exists=.env.development\"",
    "dev:http": "pnpm build && cross-env PROXY_PROTOCOL=http pnpm start:dev",
    "dev:socks": "pnpm build && cross-env PROXY_PROTOCOL=socks pnpm start:dev",
    "dev:tls": "pnpm build && cross-env PROXY_PROTOCOL=tls pnpm start:dev",
    "start:http": "cross-env PROXY_PROTOCOL=http pnpm start",
    "start:socks": "cross-env PROXY_PROTOCOL=socks pnpm start",
    "start:tls": "cross-env PROXY_PROTOCOL=tls pnpm start",
    "build:pkg": "pnpm build && pkg .",
    "postinstall": "node scripts/patch-pkg-fetch.mjs",
    "lint": "eslint ./src --ext .ts"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "pkg": "^5.8.1",
    "typescript": "^5.8.3"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      ".env",
      ".env.*",
      "package.json",
      "README.md"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64",
      "node22-darwin-x64"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
