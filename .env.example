# 基础
PORT=3000
CACHE_TYPE=memory
# 代理协议：http/https/socks/tls（兼容 PROXY_TYPE / PROXY_SERVICE_TYPE）
PROXY_PROTOCOL=http
# 日志等级：debug/info/warn/error/silent（兼容 LOGLEVEL）
LOG_LEVEL=info
# 日志持久化：目录 log 按小时分文件 log/YYYY-MM-DD-HH.log（兼容 LOGFILE/LOG_PATH），留空仅控制台
LOG_FILE=log
# 上游超时 ms：超时回 504/断开隧道（兼容 PROXY_TIMEOUT/TIMEOUT，CLI: --upstream-timeout）
UPSTREAM_TIMEOUT=10000
# 鉴权总开关：true=开启 false=关闭（兼容 APP_USE_AUTH / USE_AUTH）
AUTH_ENABLED=false
# 鉴权类型：none=无鉴权 basic=账号密码 jwt=Bearer Token（仅 AUTH_ENABLED=true 时生效）
AUTH_TYPE=none
# basic 时生效
AUTH_USERNAME=
AUTH_PASSWORD=
# jwt 时生效（兼容 PROXY_SECRET / JWT_KEY）
JWT_SECRET=
# 鉴权日志：true=输出 allow/deny 审计（WARN/INFO），false=静默（兼容 AUTH_LOG/LOG_AUTH，CLI: --auth-logging）
AUTH_LOGGING=true
# TLS 证书路径：仅 https/tls 生效，相对路径以项目根为基准（兼容 TLS_KEY_PATH/SSL_KEY 等，CLI: --tls-key/--tls-cert/--tls-ca）
TLS_KEY=keys/server.key
TLS_CERT=keys/server.crt
TLS_CA=keys/ca.crt
# TLS 私钥口令：仅私钥为 ENCRYPTED PRIVATE KEY 时需填（兼容 TLS_KEY_PASS/SSL_PASSPHRASE/PASSPHRASE，CLI: --tls-passphrase）
TLS_PASSPHRASE=
# 客户端目标代理（ProxyClient 直连的目标服务器，http/socks 均用此组，CLI: --remote-host 等）
REMOTE_HOST=127.0.0.1
REMOTE_PORT=3000
REMOTE_SECURE=false
REMOTE_USERNAME=
REMOTE_PASSWORD=
REMOTE_CA=keys/ca.crt
REMOTE_INSECURE=false
# 运行模式：server=服务端常驻，client=客户端（PROXY_MODE/MODE，CLI: --proxy-mode）
PROXY_MODE=server
# cluster worker 进程数：1=单进程(默认)，>1=master fork N 个 worker 共享端口，0=按 CPU 核数（CLI: --cluster-workers）
CLUSTER_WORKERS=1
