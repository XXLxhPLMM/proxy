# 基础
PORT=3000
CACHE_TYPE=memory
# 代理协议：http/https/socks/tls（兼容 PROXY_TYPE / PROXY_SERVICE_TYPE）
PROXY_PROTOCOL=http
# 日志等级：debug/info/warn/error/silent（兼容 LOGLEVEL）
LOG_LEVEL=info
# 日志持久化：目录 log 按小时分文件 log/YYYY-MM-DD-HH.log（兼容 LOGFILE/LOG_PATH），留空仅控制台
LOG_FILE=log
# 鉴权总开关：true=开启 false=关闭（兼容 APP_USE_AUTH / USE_AUTH）
AUTH_ENABLED=false
# 鉴权类型：none=无鉴权 basic=账号密码 jwt=Bearer Token（仅 AUTH_ENABLED=true 时生效）
AUTH_TYPE=none
# basic 时生效
AUTH_USERNAME=
AUTH_PASSWORD=
# jwt 时生效（兼容 PROXY_SECRET / JWT_KEY）
JWT_SECRET=
