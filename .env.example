# 基础
PORT=3000
CACHE_TYPE=memory
# 代理协议：http/https/socks4/socks5/sockss4/sockss5
PROXY_PROTOCOL=http
# 控制台日志等级：debug/info/warn/error/silent（CLI: --log-level）
LOG_LEVEL=error
# 落盘日志等级：debug/info/warn/error/silent，与 LOG_LEVEL 独立（CLI: --log-file-level）
LOG_FILE_LEVEL=info
# 日志持久化：目录 log 按小时分文件 log/YYYY-MM-DD-HH.log，留空完全不落盘
LOG_FILE=log
# 上游超时 ms：超时回 504/断开隧道（CLI: --upstream-timeout）
UPSTREAM_TIMEOUT=10000
# 鉴权总开关：true=开启 false=关闭
AUTH_ENABLED=false
# 鉴权类型：none=无鉴权 basic=账号密码 jwt=Bearer Token（仅 AUTH_ENABLED=true 时生效）
AUTH_TYPE=none
# basic 时生效
AUTH_USERNAME=
AUTH_PASSWORD=
# jwt 时生效
JWT_SECRET=
# 鉴权日志：true=输出 allow/deny 审计（WARN/INFO），false=静默（CLI: --auth-logging）
AUTH_LOGGING=true
# TLS 证书路径：仅 https/sockss4/sockss5 生效，相对路径以项目根为基准（CLI: --tls-key/--tls-cert/--tls-ca）
TLS_KEY=keys/server.key
TLS_CERT=keys/server.crt
TLS_CA=keys/ca.crt
# TLS 私钥口令：仅私钥为 ENCRYPTED PRIVATE KEY 时需填（CLI: --tls-passphrase）
TLS_PASSPHRASE=
# 客户端目标代理标准 URL（推荐，整体覆盖下面的 UPSTREAM 拆项）
# 形式 scheme://[user:pass@]host[:port]，scheme ∈ http/https/socks4/socks5/sockss4/sockss5
# 缺省端口按 scheme 补齐（http:80 / https,sockss4,sockss5:443 / socks4,socks5:1080），拒绝携带 path/query
# 例：UPSTREAM_URL=https://user:pass@proxy.example.com:8443
# UPSTREAM_URL=
# 客户端目标代理拆项（未配 UPSTREAM_URL 时生效，CLI: --upstream-host 等）
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3000
UPSTREAM_SECURE=false
UPSTREAM_USERNAME=
UPSTREAM_PASSWORD=
UPSTREAM_CA=keys/ca.crt
UPSTREAM_INSECURE=false
# 运行模式：server=服务端常驻，client=客户端（CLI: --proxy-mode）
PROXY_MODE=server
# cluster worker 进程数：1=单进程(默认)，>1=master fork N 个 worker 共享端口，0=按 CPU 核数（CLI: --cluster-workers）
CLUSTER_WORKERS=1
