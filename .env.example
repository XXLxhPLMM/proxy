# ============================================================================
# @b-hole/proxy 环境变量全量清单 —— 共 33 项，与 src/config/fields.ts 的 FIELDS 表一一对应
#
# 优先级：CLI 参数  >  终端环境变量  >  本文件(.env)  >  默认值
#   - .env 加载顺序（低 → 高，后者覆盖前者）：.env.production → .env.development → .env.<NODE_ENV>
#   - 终端已存在的变量永不被文件覆盖
#   - 未设置的键一律回落默认值；显式写了非法值直接启动中止（fail-closed），绝不静默回退
#
# 每项标注：说明 + [默认 xxx] + 生效时机
#   [启动]   = 启动时一次性读取，改动需重启进程
#   [运行时] = 每请求/连接重新读取，热生效（可经 set() 热改）
#
# 本文件所有取值均等于默认值：cp .env.example .env 后不改也能原样运行
# ============================================================================

# ──────────────────────────── 基础 ────────────────────────────

# 监听地址 [启动] [默认 0.0.0.0]（0.0.0.0 = 监听所有网卡；CLI: --host）
HOST=0.0.0.0

# 监听端口，整数 1-65535 [启动] [默认 3000]（CLI: --port）
PORT=3000

# 代理协议 [启动] [默认 http]（CLI: --proxy-protocol）
# http=明文 HTTP+CONNECT / https=TLS+HTTP / socks4 / socks5 / sockss4=TLS+SOCKS4 / sockss5=TLS+SOCKS5
PROXY_PROTOCOL=http

# 运行模式 [运行时] [默认 server]（CLI: --proxy-mode）
# server = 服务端直连目标；client = 作为客户端把流量转发给 UPSTREAM_* 指定的上游代理
PROXY_MODE=server

# cluster worker 进程数，整数 0-1024 [启动] [默认 1]（CLI: --cluster-workers）
# 1 = 单进程（默认）；>1 = master fork N 个 worker 共享监听端口、崩溃自动重启；0 = 按 CPU 核数
CLUSTER_WORKERS=1

# 从用户主目录 ~/.proxy/ 读配置（.env、keys/、log/ 等均以 ~/.proxy 为基准） [启动] [默认 false]
# false = 用当前工作目录；true = 切到 ~/.proxy/，配一次全局可用
# ⚠️ 鸡生蛋：该值在加载 .env 文件**之前**从「CLI / 终端环境变量」解析，
#    写进本文件不生效 —— 只能用 --use-home-config 或终端 USE_HOME_CONFIG=true 切换，故此处保持注释
# USE_HOME_CONFIG=false

# ──────────────────────────── 缓存 ────────────────────────────

# 缓存后端 [运行时] [默认 memory]：memory = 进程内存；redis = 外置 Redis
CACHE_TYPE=memory

# ──────────────────────────── 日志 ────────────────────────────

# 控制台日志等级 [运行时] [默认 error]（CLI: --log-level）
# 可选：debug / info / warn / error / silent
LOG_LEVEL=error

# 落盘日志等级 [运行时] [默认 info]，与 LOG_LEVEL 完全独立（终端求安静、文件求详尽，各调各的）（CLI: --log-file-level）
# 可选：debug / info / warn / error / silent
LOG_FILE_LEVEL=info

# 日志持久化路径 [运行时] [默认 log]（CLI: --log-file）
# 填目录或文件均可，按小时切成 log/YYYY-MM-DD-HH.jsonl（每行一个 JSON 对象，可 jq 查询）；留空 = 完全不落盘
LOG_FILE=log

# ──────────────────────────── 鉴权 ────────────────────────────

# 鉴权总开关 [运行时] [默认 false]：true = 开启，false = 关闭（优先于 AUTH_TYPE）（CLI: --auth-enabled）
AUTH_ENABLED=false

# 鉴权类型 [运行时] [默认 none]（CLI: --auth-type）
# none = 不校验 / basic = 账号密码 / jwt = Bearer Token / uid = 仅用户名（socks4 由 USERID 承载）
# ⚠️ AUTH_ENABLED=true 时：AUTH_TYPE=none（自相矛盾）、basic/uid 账号表为空、jwt 无 JWT_SECRET
#    —— 三种组合都会直接启动中止（fail-closed），不会静默放行或全拒
AUTH_TYPE=none

# 账号表路径 [运行时] [默认 <配置目录>/cfg/users.json]（CLI: --auth-users-file）
# 内容 [{ "username": "alice", "password": "pw1" }]，多账号即多项；文件缺失 = 无账号
# 文件含密码，已 .gitignore 忽略，仓库只提供 cfg/users.json.example（复制为 cfg/users.json 后使用）
# 内容改坏：启动时中止；运行期保留上一份有效值 + 告警；改动最多 1 秒热生效
AUTH_USERS_FILE=cfg/users.json

# JWT 密钥 [运行时] [默认空]（CLI: --jwt-secret）
# AUTH_TYPE=jwt 时必填，空则启动中止
JWT_SECRET=

# 鉴权审计日志 [运行时] [默认 true]（CLI: --auth-logging）
# true = 输出 allow/deny 审计日志；false = 静默
AUTH_LOGGING=true

# ──────────────────────────── 访问控制（ACL） ────────────────────────────

# 访问控制名单路径 [运行时] [默认 <配置目录>/cfg/acl.json]（CLI: --acl-file）
# 内容三组，每组 whitelist/blacklist：
# - clientIp：来源判定（谁能用这个代理），**只收 IP/CIDR**，按 TCP 对端地址、不看 XFF；黑>白，拒绝
# - target：目标判定（能不能访问），收 IP/CIDR/域名/*.通配域名，按请求 host 字符串、不做 DNS、不支持端口；黑>白，拒绝
# - upstream：路由判定（怎么路由），条目语法同 target；**仅 PROXY_MODE=client 生效**（server 模式完全忽略）；
#   动作 = 直连（不交上游）：黑名单命中 → 直连（黑 > 白）/ whitelist 非空未命中 → 直连 / 皆空 → 走上游（默认，同旧版）
# clientIp/target 语义：黑名单命中拒绝（优先）/ 白名单非空未命中拒绝 / 皆空放行
# 文件缺失 = 三组全空（不拦任何请求、client 模式全走上游）；内容非法（未知键/非法条目）：启动时中止、运行期保留旧值 + 告警；改动最多 1 秒热生效
# 拒绝行为：HTTP/CONNECT/WS 回 403（名单拒绝与凭证无关，刻意不回 407；clientIp 拒绝早于鉴权、target 拒绝在鉴权后拨号前）；
#   SOCKS：clientIp 拒绝握手前直接断开、target 拒绝回失败应答；client 模式放行请求另记一条 [route]（target + route=direct|upstream，直连时带 reason=blacklist|whitelist）
# 文件含名单，已 .gitignore 忽略，仓库只提供 cfg/acl.json.example
ACL_FILE=cfg/acl.json

# ──────────────────────────── 每用户流量配额 ────────────────────────────

# ⚠️ 配额本身不在本文件：它写在 AUTH_USERS_FILE 指向的账号表的 quota 组里
#   （{ "bytesUp": N, "bytesDown": N, "bytesTotal": N, "window": "day"|"month" }，三个字节字段
#     各自可选、全 0 = 该用户不限流；window 缺省 = month，只认 day/month 两个日历窗）。
#   下面三项是**围绕**配额的运行参数。本文件取值均等于默认值，故不改变任何行为。

# 配额账本目录 [启动] [默认 <配置目录>/cfg/quota]（CLI: --quota-ledger-dir）
# ⚠️ 必须是启动期：运行中改目录 = 已打开的账本 append 句柄仍指向旧文件，**改了等于没改**。
#    要改必须重启进程 / 重建 runtime。
QUOTA_LEDGER_DIR=cfg/quota

# 配额窗口重置小时，整数 0-23 [运行时] [默认 0]（CLI: --quota-reset-hour）
# 本地时区。window=day 时它是「新一天的第一刻」：设 3 表示 01:00 仍算前一天、03:00 才翻页。
# 热改立即生效（账本每次访问现读），不必重启。
QUOTA_RESET_HOUR=0

# 配额 delta 落盘间隔 ms，整数 >=1 [运行时] [默认 5000]（CLI: --quota-flush-interval）
QUOTA_FLUSH_INTERVAL=5000

# ──────────────────────────── TLS / mTLS ────────────────────────────

# TLS 服务端私钥 [启动] [默认 keys/server.key]（仅 https/sockss4/sockss5 生效，其余协议忽略）（CLI: --tls-key）
TLS_KEY=keys/server.key

# TLS 服务端证书 [启动] [默认 keys/server.crt]（与 TLS_KEY 配对使用）（CLI: --tls-cert）
TLS_CERT=keys/server.crt

# 客户端证书 CA = mTLS 开关 [启动] [默认空 = 只做服务端 TLS，不要求客户端证书]（CLI: --tls-ca）
# 非空即强制客户端证书必须由该 CA 签发；文件读不到 → 启动中止（绝不静默降级为不校验）
# 试用可填 keys/ca.crt（配套 keys/client.crt + keys/client.key；仓库自带测试 PKI，私钥已提交，勿用于生产）
TLS_CA=

# TLS 私钥口令 [启动] [默认空]（仅私钥为 ENCRYPTED PRIVATE KEY 时需填）（CLI: --tls-passphrase）
TLS_PASSPHRASE=

# ──────────────────────────── 上游代理（PROXY_MODE=client 时生效） ────────────────────────────

# 上游代理标准 URL [运行时] [默认空 = 不启用，走下方拆项]（CLI: --upstream-url）
# 形式 scheme://[user:pass@]host[:port]，scheme ∈ http/https/socks4/socks5/sockss4/sockss5
# 缺省端口按 scheme 补齐（http:80 / https,sockss4,sockss5:443 / socks4,socks5:1080），拒绝携带 path/query/hash
# 配置后整体覆盖下方 UPSTREAM_* 拆项（被覆盖的拆项会告警）；UPSTREAM_CA / UPSTREAM_INSECURE 不受其影响
# 例：UPSTREAM_URL=https://user:pass@proxy.example.com:8443
UPSTREAM_URL=

# 以下拆项仅在未配 UPSTREAM_URL 时生效

# 上游主机 [运行时] [默认 127.0.0.1]（CLI: --upstream-host）
UPSTREAM_HOST=127.0.0.1

# 上游端口，整数 1-65535 [运行时] [默认 3000]（CLI: --upstream-port）
UPSTREAM_PORT=3000

# 上游代理协议 [运行时] [默认 http]（CLI: --upstream-protocol）
# 取值同 PROXY_PROTOCOL，且与入站协议**正交**：可本地 http 入站 → 上游 sockss5 出站（链式异构）
UPSTREAM_PROTOCOL=http

# 上游连接是否 TLS [运行时] [默认 false]（CLI: --upstream-secure）
UPSTREAM_SECURE=false

# 上游用户名 [运行时] [默认空]（CLI: --upstream-username）
UPSTREAM_USERNAME=

# 上游密码 [运行时] [默认空]（CLI: --upstream-password）
UPSTREAM_PASSWORD=

# 上游 CA 证书路径 [运行时] [默认空 = 用系统信任库校验]（CLI: --upstream-ca）
# 串联公网 HTTPS 上游必须留空；仅自签上游才填 —— 填了会**整体替换**系统信任库（只信该 CA，公网 CA 链将失败）
UPSTREAM_CA=

# 跳过上游证书校验 [运行时] [默认 false]（CLI: --upstream-insecure）
UPSTREAM_INSECURE=false

# 上游超时 ms，整数 >=1 [运行时] [默认 10000]（CLI: --upstream-timeout）
# 拨号 + 转发共用容忍上限，超时回 504 / 断开隧道；同时是 cluster 停机 grace 基数
UPSTREAM_TIMEOUT=10000
