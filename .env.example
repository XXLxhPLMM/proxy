# 基础
PORT=3000
CACHE_TYPE=memory
# 代理协议：http/https/socks4/socks5/sockss4/sockss5
PROXY_PROTOCOL=http
# 控制台日志等级：debug/info/warn/error/silent（CLI: --log-level）
LOG_LEVEL=error
# 落盘日志等级：debug/info/warn/error/silent，与 LOG_LEVEL 独立（CLI: --log-file-level）
LOG_FILE_LEVEL=info
# 日志持久化：目录 log 按小时分文件 log/YYYY-MM-DD-HH.jsonl（JSONL，每行一个 JSON 对象，可 jq 查询），留空完全不落盘
LOG_FILE=log
# 上游超时 ms：超时回 504/断开隧道（CLI: --upstream-timeout）
UPSTREAM_TIMEOUT=10000
# 鉴权总开关：true=开启 false=关闭
AUTH_ENABLED=false
# 鉴权类型：none=无鉴权 basic=账号密码 jwt=Bearer Token uid=仅用户名（仅 AUTH_ENABLED=true 时生效）
AUTH_TYPE=none
# 账号表路径（basic/uid 时生效）：内容为 [{ "username": "alice", "password": "pw1" }, ...]，多账号即多项
# 缺省 <配置目录>/cfg/users.json；文件含密码，已 .gitignore 忽略，仓库只提供 cfg/users.json.example（复制为 cfg/users.json 后使用）
# 开启 basic/uid 却账号表为空会在启动时直接 abort（fail-closed）
AUTH_USERS_FILE=cfg/users.json
# jwt 时生效
JWT_SECRET=
# 访问控制名单路径：clientIp（来源 IP/CIDR）与 target（目标 IP/CIDR/域名/*.域名）两组黑白名单
# 缺省 <配置目录>/cfg/acl.json；文件缺失 = 不拦任何请求；已 .gitignore 忽略，仓库只提供 cfg/acl.json.example
ACL_FILE=cfg/acl.json
# 鉴权日志：true=输出 allow/deny 审计（WARN/INFO），false=静默（CLI: --auth-logging）
AUTH_LOGGING=true
# TLS 服务端证书：仅 https/sockss4/sockss5 生效，相对路径以项目根为基准（CLI: --tls-key/--tls-cert）
TLS_KEY=keys/server.key
TLS_CERT=keys/server.crt
# 客户端证书 CA（mTLS）：留空 = 只做服务端 TLS（不向客户端索要证书）
# 填了即为 mTLS 开关：强制要求客户端证书由该 CA 签发，文件读不到会直接启动 abort（绝不静默降级）
# 试用可填 keys/ca.crt（配套客户端证书 keys/client.crt + keys/client.key，都是仓库自带的测试 PKI，私钥已提交，勿用于生产）
TLS_CA=
# TLS 私钥口令：仅私钥为 ENCRYPTED PRIVATE KEY 时需填（CLI: --tls-passphrase）
TLS_PASSPHRASE=
# 客户端目标代理标准 URL（推荐，整体覆盖下面的 UPSTREAM 拆项）
# 形式 scheme://[user:pass@]host[:port]，scheme ∈ http/https/socks4/socks5/sockss4/sockss5
# 缺省端口按 scheme 补齐（http:80 / https,sockss4,sockss5:443 / socks4,socks5:1080），拒绝携带 path/query
# 例：UPSTREAM_URL=https://user:pass@proxy.example.com:8443
# UPSTREAM_URL=
# 客户端目标代理拆项（未配 UPSTREAM_URL 时生效，CLI: --upstream-host 等）
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3000
UPSTREAM_SECURE=false
UPSTREAM_USERNAME=
UPSTREAM_PASSWORD=
# 上游 CA 证书路径（可选）：留空 = 用系统信任库校验上游证书（串联公网 HTTPS 上游必须留空）
# 仅自签上游才填；填了会整体替换系统信任库（只信任该 CA，公网 CA 链会校验失败）
UPSTREAM_CA=
UPSTREAM_INSECURE=false
# 运行模式：server=服务端常驻，client=客户端（CLI: --proxy-mode）
PROXY_MODE=server
# cluster worker 进程数：1=单进程(默认)，>1=master fork N 个 worker 共享端口，0=按 CPU 核数（CLI: --cluster-workers）
CLUSTER_WORKERS=1
