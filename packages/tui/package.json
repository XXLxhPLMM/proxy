{
  "name": "@b-hole/proxy-tui",
  "version": "5.3.0",
  "description": "Terminal console for the @b-hole/proxy control plane (multi-manager)",
  "private": true,
  "type": "module",
  "bin": {
    "proxy-tui": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "start": "node dist/cli.js",
    "dev": "node build.mjs --dev && node dist/cli.js",
    "lint": "eslint ./src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/deepseek": "^3.0.63",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/mistral": "^4.0.62",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/xai": "^5.0.20",
    "@inkjs/ui": "^2.0.0",
    "ai": "^7.0.137",
    "axios": "^1.20.0",
    "drizzle-orm": "1.0.0-rc.4",
    "ink": "^7.1.1",
    "node-sqlite3-wasm": "^0.8.60",
    "react": "^19.2.0",
    "string-width": "^8.2.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
