# 开发环境 - socks 测试配置
PORT=3000
CLUSTER_WORKERS=0
CACHE_TYPE=memory
PROXY_PROTOCOL=socks4
LOG_LEVEL=silent
LOG_FILE=log
UPSTREAM_TIMEOUT=10000
AUTH_ENABLED=true
AUTH_TYPE=uid
# 账号表：开发前先 `cp cfg/users.json.example cfg/users.json`，否则账号表为空会启动 abort（fail-closed）
AUTH_USERS_FILE=./cfg/users.json
AUTH_LOGGING=true
