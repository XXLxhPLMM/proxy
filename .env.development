# 开发环境 - http 鉴权测试配置
PORT=3000
CACHE_TYPE=memory
PROXY_PROTOCOL=http
LOG_LEVEL=info
LOG_FILE=log
UPSTREAM_TIMEOUT=10000
# 鉴权：basic 账号 test/123
AUTH_ENABLED=true
AUTH_TYPE=basic
AUTH_USERNAME=test
AUTH_PASSWORD=123
JWT_SECRET=
AUTH_LOGGING=true
TLS_KEY=keys/server.key
TLS_CERT=keys/server.crt
TLS_CA=keys/ca.crt
