# 开发环境 - https 测试配置（关闭鉴权）
PORT=3000
CLUSTER_WORKERS=2
CACHE_TYPE=memory
PROXY_PROTOCOL=http
LOG_LEVEL=info
LOG_FILE=log
UPSTREAM_TIMEOUT=10000
# 鉴权：关闭
AUTH_ENABLED=false
AUTH_TYPE=basic
AUTH_USERNAME=test
AUTH_PASSWORD=123
JWT_SECRET=
AUTH_LOGGING=true
TLS_KEY=keys/server.key
TLS_CERT=keys/server.crt
TLS_CA=keys/ca.crt
TLS_PASSPHRASE=
